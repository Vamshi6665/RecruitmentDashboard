# Copy to .env (repo root or server/). Every setting is read in server/src/config.js.

# athena | json | auto   (auto = try Athena, fall back to exported JSON if it can't connect)
DATA_SOURCE=auto

# AWS credentials come from the standard chain: `aws configure`, AWS_PROFILE, env keys, or an IAM role.
AWS_REGION=us-east-1
# AWS_PROFILE=default

# On Vercel (or any host that manages AWS_* itself) use these instead. They take priority when set.
# ATHENA_REGION=us-east-1
# ATHENA_ACCESS_KEY_ID=
# ATHENA_SECRET_ACCESS_KEY=

ATHENA_DATABASE=recruiting_history
ATHENA_WORKGROUP=primary
# Where Athena writes query results. Required unless your workgroup enforces one.
ATHENA_OUTPUT_LOCATION=s3://vamshi-recruiting-dashboard-demo-20261004/athena-results/
ATHENA_TIMEOUT_MS=60000
ATHENA_PROBE_TIMEOUT_MS=20000
# After a fallback to JSON, try Athena again after this many minutes
ATHENA_RETRY_MINUTES=2

# In-memory LRU cache for query results
CACHE_MAX_ENTRIES=300
CACHE_TTL_MINUTES=15

RATE_LIMIT_PER_MIN=120
PORT=8787
# Comma-separated origins allowed to call the API from another host (blank = same origin only)
CORS_ORIGINS=
# JSON_DATA_DIR=client/public/data

# Client (Vite) — optional
# VITE_API_BASE=https://recruiting-api.example.com
# VITE_DATA_MODE=auto
